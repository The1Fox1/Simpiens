<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine-free simulation core: the same files as the Unity assembly Simpiens.Core (Assets/Simpiens.Core).
       netstandard2.1 is built too, so an API Unity lacks fails here before it fails in Unity. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Simpiens.Core</AssemblyName>
    <RootNamespace>Simpiens</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AssetsRoot)Simpiens.Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ZLogger" Version="2.5.10" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
  </ItemGroup>
</Project>
