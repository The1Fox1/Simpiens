<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine-free simulation core. It references no engine, but the client references it, so it targets the
       client's .NET (Directory.Build.props). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Simpiens.Core</AssemblyName>
    <RootNamespace>Simpiens</RootNamespace>
    <!-- Always optimized, so the zero-allocation validators check the code as it ships: a Debug build turns every
         async method's state machine into a class that allocates per call -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ZLogger" Version="2.5.10" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
  </ItemGroup>
</Project>
