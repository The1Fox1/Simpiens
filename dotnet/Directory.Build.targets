<Project>
  <!-- KNI or MonoGame, for the few lines that must differ (Epic CLIENT: they live in Simpiens.Client's XnaPlatform) -->
  <PropertyGroup Condition="'$(XnaFramework)' == 'Kni'">
    <DefineConstants>$(DefineConstants);KNI</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XnaFramework)' == 'MonoGame'">
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>
  </PropertyGroup>
</Project>
