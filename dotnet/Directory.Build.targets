<Project>
  <!-- On net10.0 the MemoryPack generator emits C# 11+ (static abstract interface members), so those builds use the
       latest language version. The core is still held to C# 10 by its netstandard2.1 build.
       (Here, not in Directory.Build.props: a single-target project sets TargetFramework after the props are read.) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!-- KNI or MonoGame, for the few lines that must differ (Epic CLIENT: they live in Simpiens.Client's XnaPlatform) -->
  <PropertyGroup Condition="'$(XnaFramework)' == 'Kni'">
    <DefineConstants>$(DefineConstants);KNI</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XnaFramework)' == 'MonoGame'">
    <DefineConstants>$(DefineConstants);MONOGAME</DefineConstants>
  </PropertyGroup>
</Project>
