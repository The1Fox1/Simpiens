<Project>
  <!-- Shared settings for the .NET side of Simpiens (Epic CORE Phase 1). The simulation's source lives under Assets/
       and is compiled here by glob: Unity compiles the same files, so they stay at C# 10 and netstandard2.1 APIs. -->
  <PropertyGroup>
    <!-- C# 10 where Unity's API level is checked (netstandard2.1); net10.0 builds raise it in Directory.Build.targets -->
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssetsRoot>$(MSBuildThisFileDirectory)../Assets/</AssetsRoot>
  </PropertyGroup>
</Project>
